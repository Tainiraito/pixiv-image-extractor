{
    "manifest_version": 3,
    "name": "Pixiv 图片提取",
    "version": "1.3.0",
    "description": "后台提取并下载 Pixiv 高清图片，支持预览、批量下载和低内存分卷打包",
    "minimum_chrome_version": "116",
    "permissions": [
        "activeTab",
        "downloads",
        "declarativeNetRequest",
        "offscreen",
        "storage"
    ],
    "host_permissions": [
        "https://www.pixiv.net/*",
        "https://i.pximg.net/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Pixiv 图片提取"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.pixiv.net/artworks/*",
                "https://www.pixiv.net/illust/*",
                "https://www.pixiv.net/users/*/artworks/*"
            ],
            "js": ["content.js"]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "pixiv_referer",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
